# Production settings. deploy/remote.sh generates ~/querion/shared/.env from this shape on the
# FIRST deploy only (random secrets) and never overwrites it afterwards. Keep it chmod 600.

PUBLIC_DOMAIN=59-153-246-116.sslip.io      # web + API; demo site is served at demo.<PUBLIC_DOMAIN>
ACME_EMAIL=                                # optional, for certificate expiry notices
BRAND_NAME=MSB Knowledge Assistant

POSTGRES_USER=querion
POSTGRES_PASSWORD=<random>
POSTGRES_DB=querion
MINIO_ROOT_USER=querion
MINIO_ROOT_PASSWORD=<random>

JWT_SECRET=<random>
ENCRYPTION_KEY=<fernet key>                # encrypts provider API keys and tool secrets; never change it after seeding
SUPER_ADMIN_EMAIL=admin@querion.io
SUPER_ADMIN_PASSWORD=<random>

PII_ENGINE=presidio
ENABLE_MCP_STDIO=false

# AI providers created by the first seed (copied from the local active providers)
SEED_LLM_PROVIDER=vngcloud
SEED_LLM_MODEL=google/gemma-4-31b-it
SEED_LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
SEED_LLM_API_KEY=<key>
SEED_EMBEDDING_PROVIDER=openrouter
SEED_EMBEDDING_MODEL=openai/text-embedding-3-small
SEED_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
SEED_EMBEDDING_API_KEY=<key>
