# ---- Postgres ----
POSTGRES_USER=querion
POSTGRES_PASSWORD=querion_secret
POSTGRES_DB=querion
DATABASE_URL=postgresql+asyncpg://querion:querion_secret@localhost:5432/querion

# ---- Redis ----
REDIS_URL=redis://localhost:6390/0

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=querion-docs
MINIO_USE_SSL=false

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BRAND_NAME=MSB Knowledge Assistant
NEXT_PUBLIC_BRAND_SHORT=MSB KA

# ---- Auth / JWT ----
JWT_SECRET=querion-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Super Admin Seed ----
SUPER_ADMIN_EMAIL=admin@querion.io
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_NAME=Super Admin

# ---- Encryption (Fernet key for API key encryption in DB) ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Demo seed (python -m app.seed_demo) — optional, creates active AI providers ----
SEED_LLM_PROVIDER=vngcloud          # openai | google | anthropic | openrouter | vngcloud | openai_compatible
SEED_LLM_MODEL=google/gemma-4-31b-it
SEED_LLM_API_KEY=
SEED_LLM_BASE_URL=                  # optional; defaults per provider (see app/models/model_registry.py)
SEED_EMBEDDING_PROVIDER=openrouter  # openai | google | openrouter | openai_compatible
SEED_EMBEDDING_MODEL=openai/text-embedding-3-small
SEED_EMBEDDING_API_KEY=
SEED_EMBEDDING_BASE_URL=

# ---- Workflow runtime hardening ----
ENABLE_CODE_EXECUTE=false          # code_execute node uses exec(); enable only for trusted demos
HTTP_REQUEST_ALLOW_PRIVATE=false   # allow http_request node to call localhost/private IPs
# -- Công cụ (tool) của trợ lý --
TOOL_INTERNAL_ALLOWLIST=            # host nội bộ tool được gọi, vd "core-api.msb.local:8443,localhost:8095"
ENABLE_MCP_STDIO=false              # MCP qua stdio chạy tiến trình cục bộ, chỉ bật khi thật sự cần
AGENT_MAX_TOOL_ROUNDS=4

# -- Giới hạn tần suất (mặc định đã hợp lý, bỏ comment để đổi) --
# PUBLIC_RATE_LIMIT_PER_IP=20        # tin nhắn / (trợ lý, IP) / cửa sổ, cho trang khách và bong bóng nhúng
# PUBLIC_RATE_WINDOW_SEC=300
# PUBLIC_RATE_LIMIT_PER_APP_DAY=2000 # tin nhắn / trợ lý / ngày
# STAFF_RATE_LIMIT_PER_EMPLOYEE=60   # tin nhắn / (trợ lý, cán bộ) / cửa sổ

PII_ENGINE=presidio                # presidio (Microsoft Presidio + spaCy en_core_web_sm) | regex (no model needed) | off
WORKER_LOG_LEVEL=INFO              # indexing worker log level; DEBUG makes pdfminer log ~500k lines per PDF and slows parsing 10-50x
